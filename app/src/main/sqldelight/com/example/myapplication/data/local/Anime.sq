CREATE TABLE anime (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    imagePath TEXT,
    episodes INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    status TEXT NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL,
    orderIndex INTEGER NOT NULL DEFAULT 0,
    dateAdded INTEGER NOT NULL,
    categoryType TEXT NOT NULL DEFAULT '',
    sync_status TEXT NOT NULL DEFAULT 'SYNCED',
    comment TEXT NOT NULL DEFAULT '',
    isAiRecommendation INTEGER NOT NULL DEFAULT 0,
    anilist_id INTEGER,
    mal_id INTEGER,
    shikimori_id INTEGER,
    anilist_not_found_at INTEGER,
    mal_not_found_at INTEGER,
    shikimori_not_found_at INTEGER,
    isPrivate INTEGER NOT NULL DEFAULT 0,
    encryptionIv TEXT,
    deletedAt INTEGER,
    mediaType TEXT NOT NULL DEFAULT 'ANIME',
    -- Английское название (автообогащение через API/AI). NULL = ещё не заполнено.
    title_en TEXT,
    -- Время последней попытки обогащения EN-названия (чтобы не перепроверять бесконечно).
    title_en_checked_at INTEGER,
    -- Русское название (обратное обогащение через Shikimori). NULL = ещё не заполнено.
    title_ru TEXT,
    -- Время последней попытки обогащения RU-названия.
    title_ru_checked_at INTEGER,
    -- TMDB id (MOVIE/SERIES) — канонический внешний id для фильмов/сериалов.
    tmdb_id INTEGER,
    tmdb_not_found_at INTEGER,
    -- Kinopoisk id (RU-обогащение MOVIE/SERIES) — вспомогательный, не канонический.
    kinopoisk_id INTEGER,
    kinopoisk_not_found_at INTEGER,
    -- IMDb id (MOVIE/SERIES). TEXT: канонический вид `tt0412142` со значащими ведущими нулями.
    imdb_id TEXT
);

-- Delta Sync: rows that need to be pushed to cloud
selectPendingSync:
SELECT * FROM anime WHERE sync_status != 'SYNCED' ORDER BY orderIndex ASC;

countPendingSync:
SELECT COUNT(*) FROM anime WHERE sync_status != 'SYNCED';

CREATE TABLE anime_tags (
    anime_id TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (anime_id, tag),
    FOREIGN KEY (anime_id) REFERENCES anime(id) ON DELETE CASCADE
);

getAllAnime:
SELECT * FROM anime ORDER BY orderIndex ASC;

-- One row per anime; tags aggregated for observeAllAnime() (avoids N+1 getAnimeTags calls).
getAllAnimeWithTagsConcat:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    anime.title_en,
    anime.title_ru,
    anime.tmdb_id,
    anime.tmdb_not_found_at,
    anime.kinopoisk_id,
    anime.kinopoisk_not_found_at,
    anime.imdb_id,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
GROUP BY anime.id
ORDER BY anime.orderIndex ASC;

getAnimeWithTagsConcatByType:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    anime.title_en,
    anime.title_ru,
    anime.tmdb_id,
    anime.tmdb_not_found_at,
    anime.kinopoisk_id,
    anime.kinopoisk_not_found_at,
    anime.imdb_id,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
WHERE anime.mediaType = ?
GROUP BY anime.id
ORDER BY anime.orderIndex ASC;

getAnimeCount:
SELECT COUNT(*) FROM anime;

getMaxOrderIndex:
SELECT COALESCE(MAX(orderIndex), 0) FROM anime;

getAnimePaged:
SELECT * FROM anime ORDER BY orderIndex ASC
LIMIT ? OFFSET ?;

getAnimeById:
SELECT * FROM anime WHERE id = ?;

-- Та же выборка, что у getAllAnimeWithTagsConcat, по одному id: теги одним запросом.
getAnimeWithTagsConcatById:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    anime.title_en,
    anime.title_ru,
    anime.tmdb_id,
    anime.tmdb_not_found_at,
    anime.kinopoisk_id,
    anime.kinopoisk_not_found_at,
    anime.imdb_id,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
WHERE anime.id = ?
GROUP BY anime.id;

insertAnime:
INSERT INTO anime(
    id, title, imagePath, episodes, rating, status, isFavorite, updatedAt, orderIndex, dateAdded,
    categoryType, sync_status, comment, isAiRecommendation,
    anilist_id, mal_id, shikimori_id,
    anilist_not_found_at, mal_not_found_at, shikimori_not_found_at,
    isPrivate, encryptionIv, deletedAt, mediaType, title_en, title_ru,
    tmdb_id, kinopoisk_id, tmdb_not_found_at, kinopoisk_not_found_at, imdb_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'PENDING_CREATE', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAnime:
UPDATE anime
SET title = ?,
    imagePath = ?,
    episodes = ?,
    rating = ?,
    status = ?,
    isFavorite = ?,
    updatedAt = ?,
    orderIndex = ?,
    categoryType = ?,
    sync_status = 'PENDING_UPDATE',
    comment = ?,
    isAiRecommendation = ?,
    anilist_id = ?,
    mal_id = ?,
    shikimori_id = ?,
    anilist_not_found_at = ?,
    mal_not_found_at = ?,
    shikimori_not_found_at = ?,
    isPrivate = ?,
    encryptionIv = ?,
    deletedAt = ?,
    mediaType = ?,
    title_en = ?,
    title_ru = ?,
    tmdb_id = ?,
    kinopoisk_id = ?,
    tmdb_not_found_at = ?,
    kinopoisk_not_found_at = ?,
    imdb_id = ?
WHERE id = ?;

updateAnimeFromSync:
UPDATE anime
SET title = ?,
    imagePath = ?,
    episodes = ?,
    rating = ?,
    status = ?,
    isFavorite = ?,
    updatedAt = ?,
    orderIndex = ?,
    categoryType = ?,
    comment = ?,
    isAiRecommendation = ?,
    anilist_id = ?,
    mal_id = ?,
    shikimori_id = ?,
    anilist_not_found_at = ?,
    mal_not_found_at = ?,
    shikimori_not_found_at = ?,
    isPrivate = ?,
    encryptionIv = ?,
    deletedAt = ?,
    mediaType = ?,
    sync_status = 'SYNCED'
WHERE id = ? AND (updatedAt < ? OR sync_status = 'SYNCED');

updateAnimeKeepingDirty:
UPDATE anime
SET anilist_id = coalesce(?, anilist_id),
    mal_id = coalesce(?, mal_id),
    shikimori_id = coalesce(?, shikimori_id),
    tmdb_id = coalesce(?, tmdb_id),
    kinopoisk_id = coalesce(?, kinopoisk_id),
    imdb_id = coalesce(?, imdb_id)
WHERE id = ?;


