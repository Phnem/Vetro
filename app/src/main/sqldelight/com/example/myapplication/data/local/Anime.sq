selectNeedingTitleEn:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    anime.title_en,
    anime.title_ru,
    anime.tmdb_id,
    anime.tmdb_not_found_at,
    anime.kinopoisk_id,
    anime.kinopoisk_not_found_at,
    anime.imdb_id,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
WHERE anime.mediaType = 'ANIME' AND anime.title_en IS NULL AND anime.title_en_checked_at IS NULL
GROUP BY anime.id
ORDER BY anime.dateAdded DESC
LIMIT ?;

countNeedingTitleEn:
SELECT COUNT(*) FROM anime
WHERE mediaType = 'ANIME' AND title_en IS NULL AND title_en_checked_at IS NULL;

resetTitleEnChecks:
UPDATE anime
SET title_en_checked_at = NULL, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE mediaType = 'ANIME' AND title_en IS NULL AND title_en_checked_at IS NOT NULL;

