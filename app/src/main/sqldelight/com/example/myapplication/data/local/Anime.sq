deleteAnime:
DELETE FROM anime WHERE id = ?;

-- INSERT OR REPLACE переписывает строку целиком: колонка, отсутствующая в списке ниже, стала
-- бы NULL при каждом pull, даже если синк её никогда не передавал. tmdb_id/kinopoisk_id/
-- *_not_found_at пока НЕ синкаются (нет соответствующих полей в AnimeRemoteDto/облачной
-- схеме, см. supabase/migrations/20260809000000_anime_tmdb_kinopoisk_ids.sql) — чтобы pull не
-- стирал локально проставленные значения, они не приходят параметром, а сохраняются через
-- self-select текущего значения по тому же id (подзапрос читает строку ДО REPLACE).
upsertFromSync:
INSERT OR REPLACE INTO anime(
    id, title, imagePath, episodes, rating, status, isFavorite, updatedAt, orderIndex, dateAdded,
    categoryType, sync_status, comment, isAiRecommendation,
    anilist_id, mal_id, shikimori_id,
    anilist_not_found_at, mal_not_found_at, shikimori_not_found_at,
    isPrivate, encryptionIv, deletedAt, mediaType, title_en, title_en_checked_at, title_ru, title_ru_checked_at,
    tmdb_id, tmdb_not_found_at, kinopoisk_id, kinopoisk_not_found_at, imdb_id
)
VALUES (
    :id, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'SYNCED', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
    (SELECT tmdb_id FROM anime WHERE id = :id),
    (SELECT tmdb_not_found_at FROM anime WHERE id = :id),
    (SELECT kinopoisk_id FROM anime WHERE id = :id),
    (SELECT kinopoisk_not_found_at FROM anime WHERE id = :id),
    (SELECT imdb_id FROM anime WHERE id = :id)
);

keepingDirty:
UPDATE anime
SET isPrivate = ?, encryptionIv = ?
WHERE id = ? AND sync_status != 'SYNCED';

getAnimeTags:
SELECT tag FROM anime_tags WHERE anime_id = ?;

insertAnimeTag:
INSERT INTO anime_tags(anime_id, tag)
VALUES (?, ?);

deleteAnimeTags:
DELETE FROM anime_tags WHERE anime_id = ?;

CREATE TABLE anime_update (
    anime_id TEXT NOT NULL,
    title TEXT NOT NULL,
    current_episodes INTEGER NOT NULL,
    new_episodes INTEGER NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (anime_id, new_episodes)
);

-- Локальный marker перехода SERIES на семантику "episodes = released". Отдельная таблица
-- намеренно не смешивает нормализацию со статусом provider lookup/not-found.
CREATE TABLE series_episode_normalization (
    anime_id TEXT PRIMARY KEY NOT NULL,
    FOREIGN KEY (anime_id) REFERENCES anime(id) ON DELETE CASCADE
);

countSeriesEpisodeNormalization:
SELECT COUNT(*) FROM series_episode_normalization WHERE anime_id = ?;

markSeriesEpisodesNormalized:
INSERT OR IGNORE INTO series_episode_normalization(anime_id)
VALUES (?);

CREATE TABLE ignored_update (
    anime_id TEXT PRIMARY KEY NOT NULL,
    new_episodes INTEGER NOT NULL
);

getAllUpdates:
SELECT anime_id, title, current_episodes, new_episodes, source FROM anime_update;

getIgnoredMap:
SELECT anime_id, new_episodes FROM ignored_update;

insertUpdate:
INSERT OR REPLACE INTO anime_update(anime_id, title, current_episodes, new_episodes, source)
VALUES (?, ?, ?, ?, ?);

deleteAllUpdates:
DELETE FROM anime_update;

deleteUpdateByAnimeId:
DELETE FROM anime_update WHERE anime_id = ?;

setIgnored:
INSERT OR REPLACE INTO ignored_update(anime_id, new_episodes)
VALUES (?, ?);

deleteIgnored:
DELETE FROM ignored_update WHERE anime_id = ?;
